{
  "name": "i4n",
  "version": "0.5.3",
  "description": "Lightweight, Zero dependencies, Typesafe and Simple to use translations for TypeScript.",
  "private": false,
  "types": "./dist/index.d.ts",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "homepage": "https://github.com/m10rten/i4n#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/m10rten/i4n.git"
  },
  "bugs": {
    "url": "https://github.com/m10rten/i4n/issues"
  },
  "readme": "https://github.com/m10rten/i4n#readme",
  "scripts": {
    "build": "tsup --format esm,cjs --dts",
    "lint": "eslint src/**/*.ts",
    "test": "tsx --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "test:coverage": "tsx --test --experimental-test-coverage \"tests/**/*.test.ts\"",
    "test:ci": "tsx --test \"tests/**/*.test.ts\"",
    "prettier:check": "prettier --check .",
    "format": "prettier --write .",
    "generate": "echo 'Not implemented yet.'",
    "precheck": "pnpm typecheck && pnpm lint",
    "verify": "pnpm build && pnpm test",
    "prepare": "husky"
  },
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "keywords": [
    "translations",
    "lightweight",
    "typescript",
    "i4n",
    "internationalisation",
    "translate",
    "simple-to-use"
  ],
  "author": "m10rten",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "9.27.0",
    "@types/node": "26.6.6",
    "eslint": "9.27.0",
    "husky": "9.1.7",
    "prettier": "3.10.1",
    "tsup": "8.5.0",
    "tsx": "4.19.4",
    "typescript": "5.8.3",
    "typescript-eslint": "8.32.1"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./i4n": {
      "import": {
        "types": "./dist/i4n.d.ts",
        "default": "./dist/i4n.js"
      },
      "require": {
        "types": "./dist/i4n.d.cts",
        "default": "./dist/i4n.cjs"
      }
    },
    "./errors": {
      "import": {
        "types": "./dist/errors.d.ts",
        "default": "./dist/errors.js"
      },
      "require": {
        "types": "./dist/errors.d.cts",
        "default": "./dist/errors.cjs"
      }
    },
    "./types": {
      "import": {
        "types": "./dist/types.d.ts",
        "default": "./dist/types.js"
      },
      "require": {
        "types": "./dist/types.d.cts",
        "default": "./dist/types.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "i4n": [
        "dist/i4n.d.ts"
      ],
      "errors": [
        "dist/errors.d.ts"
      ],
      "types": [
        "dist/types.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "package.json",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": ">=12",
      "onFail": "error"
    }
  }
}
